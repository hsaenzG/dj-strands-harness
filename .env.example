# Spotify (opcional) — https://developer.spotify.com/dashboard
# Redirect URI de la app: http://127.0.0.1:8000/callback
SPOTIFY_CLIENT_ID=tu-client-id
SPOTIFY_CLIENT_SECRET=tu-client-secret

# Modelo en la nube (Amazon Bedrock). Requiere credenciales AWS: `aws login`
AWS_REGION=us-east-1
# Perfil de AWS con acceso a Nova Pro (si no es el default)
# AWS_PROFILE=free-tier-Strands
# DJ_MODEL=bedrock/us.amazon.nova-pro-v1:0

# Id de la conversación (memoria de corto plazo). Cámbialo para empezar de cero.
# DJ_SESSION_ID=jsconf-mx
